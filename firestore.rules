rules_version = '2';

// Linea 2 — Firestore security rules.
// Each signed-in user can only read/write their OWN profile, cart and orders.
// Paste these in Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profile: display name, phone, shipping address.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Orders are created after a successful PayPal capture and are then
      // immutable (no client-side edits or deletes).
      match /orders/{orderId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // Saved cart (contents + quantities), one document per user.
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
