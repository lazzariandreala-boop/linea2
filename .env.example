# ─────────────────────────────────────────────────────────────────────────
# Linea 2 — environment configuration
# Copy to `.env` and adjust. No secrets or URLs are hardcoded in the codebase;
# everything flows through Nuxt runtimeConfig from these vars.
# ─────────────────────────────────────────────────────────────────────────

# Master switch for the data layer.
#   true  -> serve v5-shaped mocks, no network (default for local/dev/demo)
#   false -> fetch the live Strapi instance below
# The mock payloads are byte-shape-identical to Strapi v5, so flipping this is
# the ONLY change required to go live.
NUXT_PUBLIC_USE_MOCKS=true

# Base URL of the Strapi v5 instance (used for API calls AND media resolution).
# Leave/ignore in mock mode. Example for live: https://cms.linea2.example
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: separate host if media is fronted by a CDN. Defaults to STRAPI_URL.
# NUXT_PUBLIC_STRAPI_MEDIA_URL=https://cdn.linea2.example

# Optional server-only API token (Bearer). Only needed if your read endpoints
# are NOT public. Never exposed to the client.
# NUXT_STRAPI_TOKEN=

# Absolute public base URL of THIS site — used for canonical links and as the
# origin for absolute OpenGraph/Twitter image URLs. Set to the deployed origin.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand / default locale (i18n scaffolding).
NUXT_PUBLIC_SITE_NAME=Linea 2
NUXT_PUBLIC_DEFAULT_LOCALE=it

# Logo served from /public (drop public/logo.svg or .png). The header/footer
# show this image, falling back to the text wordmark until the file exists.
NUXT_PUBLIC_LOGO=/logo.png

# ─────────────────────────────────────────────────────────────────────────
# Firebase (Auth + Firestore) — powers login, saved cart, profile & orders.
# These web config values are PUBLIC by design (they ship in the client
# bundle); security is enforced by Firestore rules + authorized domains, NOT by
# hiding them. Sensible defaults live in nuxt.config; override per-environment
# here if you point at another Firebase project.
# ─────────────────────────────────────────────────────────────────────────
# NUXT_PUBLIC_FIREBASE_API_KEY=
# NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=
# NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NUXT_PUBLIC_FIREBASE_APP_ID=
# NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# PayPal Standard Checkout (Orders API v2 — pay-per-transaction, no fixed fee).
# Create an app at https://developer.paypal.com/dashboard/applications (start in
# Sandbox). The CLIENT_ID is public (used by the browser JS SDK); the SECRET is
# server-only and MUST NOT be committed. Set ENV=live only with LIVE credentials.
# ─────────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_PAYPAL_CLIENT_ID=
NUXT_PUBLIC_PAYPAL_CURRENCY=EUR
NUXT_PAYPAL_SECRET=
NUXT_PAYPAL_ENV=sandbox
